@pipe : gosengine_line3d
{
    rt0: U8_RGBA
    zb: _DEPTH_BEST, 1, LESS_EQUAL
    zb_allow_depthTestEnablingDisabling: 1
    zb_allow_depthWriteEnablingDisabling: 1

	cullMode: none
	drawPrimitive: trisList
    wireframe: 0

    @vtx_shader
    {
      src: vs.shader
    }

    @pxl_shader
    {
      src: ps.shader
    }
}
