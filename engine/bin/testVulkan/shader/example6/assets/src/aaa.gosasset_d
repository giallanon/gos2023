@vtx_shader : shader2.vert
{
    src: shader2.vert
}

@pxl_shader : shader2.frag
{
    src: shader2.frag
}


@pipe: pipe_1
{
	rt0: U8_RGBA
	rt1: U8_RGBA
	
	zb: _DEPTH_BEST, 1, LESS
	
	cullMode: CCW
	drawPrimitive: trisList
	wireframe: 0

	@vtx_shader
	{
		src: shader2.vert
	}

	@pxl_shader: shader2.frag
}
