//PIPE noname
@pipe
{
    rt0: U8_RGBA

    @vtx_shader
    {
      src: shader/vs1.shader
    }

    @pxl_shader : ps-per-pipe1
    {
      src: shader/ps1.shader
    }
}

//VS vs-per-pipe1
@vtx_shader : vs-per-pipe1
{
  src: shader/vs2.shader
}


//PIPE-1
@pipe: pipe-1
{
    rt0: U8_RGBA
    @vtx_shader: vs-per-pipe1
    @pxl_shader: ps-per-pipe1
}


