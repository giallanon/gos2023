//PIPE noname
@pipe
{
    rt0: U8_RGBA

    @vtx_shader
    {
      src: shader/vs1.shader
    }

    @pxl_shader
    {
      src: shader/ps1.shader
    }
}

//VS noname
@vtx_shader
{
  src: shader/vs2.shader
}

