#include "es2.gosasset_d"

@tex2D: facciaTexture
{
	src: faccia512x512.jpg
	srcColorSpace:	sRGB

	dstNumMipMap: max
	dstFmt:U8_RGBA
}


//PIPE noname
@pipe
{
    rt0: U8_RGBA

    //questo shader è completamente nuovo, esclusivamente definito qui
    @vtx_shader
    {
      src: es2.vert
    }

     //UID: 0x00020000FDE22476
    @pxl_shader
    {
      src: es2.frag
    }
}

//VS noname
@vtx_shader
{
  src: es2.vert
}

//VS-1
@vtx_shader : VS-1
{
  src: es2.vert
}

//PIPE-2
@pipe: pipe-2
{
    rt0: U8_RGBA
    @vtx_shader: VS-1
    @pxl_shader: pipedef_es2_3-pxlshader
}