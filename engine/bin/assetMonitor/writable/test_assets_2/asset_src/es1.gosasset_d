//ASSET-1
//UID atteso: 01010000286E0811, signature 000100003E35ECD5
//la versione più anonima possibile di un asset, senza nome e senza dipendenza da altri asset
@vtx_shader
{
  src: res/shader/es1.vert
  def: A1
}

//ASSET-2
//UID atteso: 0x00010000A1B9FF07
//uguala a ASSET-1 ma con un runtimeName
@vtx_shader : vtxshader_es1
{
  src: res/shader/es1.vert
}

//ASSET-3
//UID atteso: 0x00010000A1B9FF07
//duplicato esatto dell'ASSET-1
//il builder non dovrebbe generare un errore, ma non dovrebbe nemmeno ricompilare visto
//che ha già fatto ASSET-1
@vtx_shader
{
  src: res/shader/es1.vert
}


//ASSET-5
//UID atteso: 010100005CF99543, signature 00010000ADB67723
//duplicato esatto dell'ASSET-2/3, ma con un runtimeName mai utilizzato
//il builder non dovrebbe generare un errore, ma non dovrebbe nemmeno ricompilare visto
//che ha già fatto ASSET-1.
//Dovrebbe inoltre generare un nuovo link tra questo runtimeName e ASSET-1
@vtx_shader : vtxshader_es1_link2
{
  src: res/shader/es1.vert
}


//ASSET-6
//UID atteso: 0x00010000AF1C8CD3
@vtx_shader
{
  src: res/shader/es1.vert
  def: A6
}

//ASSET-7
//UID atteso: 010100000306965B, Signature: 000100005F13DBC1
@vtx_shader : vtxshader_A5
{
  src: res/shader/es1.vert
  def: A6
}



//ASSET-8
//UID atteso: 0x00010000A1B9FF07
//duplicato esatto dell'ASSET-2, con tanto di stesso runtimeName,
